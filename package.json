{
 "compilerOptions": {
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
  "target": "ES2022"
 },
 "scripts": {
  "dev": "node --env-file=.env ./node_modules/.bin/tsx watch src/server.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node --env-file=.env dist/server.js",
   "seed": "node --env-file=.env --import tsx src/dataSeedScript.ts"

 },
 "dependencies": {
  "cors": "^2.8.6",
  "dotenv": "^17.3.1",
  "express": "^5.2.1",
  "express-rate-limit": "^8.2.1",
  "firebase-admin": "^13.7.0",
  "helmet": "^8.1.0",
  "mongoose": "^9.2.4",
  "prom-client": "^15.1.3",
  "zod": "^4.3.6"
 },
 "devDependencies": {
  "@types/cors": "^2.8.19",
  "@types/express": "^5.0.6",
  "@types/node": "^25.3.0",
  "eslint": "^10.0.2",
  "tsx": "^4.21.0",
  "typescript": "^5.9.3"
 }
}
